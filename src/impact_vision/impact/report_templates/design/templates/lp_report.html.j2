<!DOCTYPE html>
<html lang="en"{% if theme %} data-theme="{{ theme }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.fund_name }} — LP impact report</title>
<style>{{ css | safe }}
.doc { max-width: 1100px; }
table.lp td, table.lp th { vertical-align: top; }
table.lp td.num { white-space: nowrap; font-variant-numeric: tabular-nums; }
.status-within { color: var(--good-ink); } .status-below { color: var(--critical-ink); } .status-above { color: var(--brand); }
</style>
</head>
<body>
<main class="doc">
<header class="masthead">
  <div class="ident">
    <div class="monogram" aria-hidden="true">LP</div>
    <div>
      <p class="eyebrow">LP impact report</p>
      <h1>{{ v.fund_name }}</h1>
      <p class="meta">As of {{ v.as_of }} · {{ v.companies | length }} portfolio {{ 'company' if v.companies | length == 1 else 'companies' }} · {{ v.pipeline }} in the pipeline</p>
    </div>
  </div>
</header>

<section class="kpis" aria-label="Fund totals">
  {% for t in v.totals %}
  <div class="tile"><p class="label">Expected at IC · {{ t.unit }}</p><p class="value">{{ sig(t.expected) }}</p><p class="sub">sum of company P50s</p></div>
  <div class="tile"><p class="label">Reported so far · {{ t.unit }}</p><p class="value">{{ sig(t.actual) if t.actual else '—' }}</p><p class="sub">{% if t.expected_matched and t.actual %}{{ '%+.0f' % ((t.actual - t.expected_matched) / t.expected_matched * 100) }}% vs expected, for the {{ t.reporting }} {{ 'company' if t.reporting == 1 else 'companies' }} reporting{% else %}no actuals yet{% endif %}</p></div>
  {% endfor %}
  {% if not v.totals %}<div class="tile"><p class="label">Expected impact</p><p class="value">—</p><p class="sub">no quantified outcomes on record</p></div>{% endif %}
</section>

<section class="card" aria-labelledby="h-companies">
  <h2 id="h-companies">Expected vs actual, company by company</h2>
  <p class="lede">Expectations are those set before the investment committee; actuals come from assessments made once the company was invested. Ranges are P10–P90.</p>
  {% if v.companies %}
  <div class="table-wrap"><table class="lp">
    <caption class="sr-only">Expected vs actual impact by portfolio company</caption>
    <thead><tr><th scope="col">Company</th><th scope="col">Outcome</th><th scope="col">Expected at IC (P50, P10–P90)</th><th scope="col">Actual</th><th scope="col">Status</th><th scope="col">Evidence</th><th scope="col">IC decision</th></tr></thead>
    <tbody>
    {% for c in v.companies %}
      {% set rows = c.comparisons or [{}] %}
      {% for r in rows %}
      <tr>
        {% if loop.first %}<th scope="row" rowspan="{{ rows | length }}">{{ c.company }}<br><small class="muted">{{ [c.sector, c.geography, c.stage] | select | join(' · ') }}</small></th>{% endif %}
        <td>{{ r.outcome or '—' }}{% if r.unit %}<br><small class="muted">{{ r.unit }}</small>{% endif %}</td>
        <td class="num">{% if r.expected %}{{ sig(r.expected.p50) }}<br><small class="muted">{{ sig(r.expected.p10) }} – {{ sig(r.expected.p90) }}</small>{% else %}—{% endif %}</td>
        <td class="num">{% if r.actual %}{{ sig(r.actual.p50) }}<br><small class="muted">{{ r.actual.period }}</small>{% else %}—{% endif %}</td>
        <td>{% if r.status %}<span class="status-{{ r.status.split(' ')[0] }}">{{ r.status }}</span>{% if r.variance_pct is defined and r.variance_pct is not none %}<br><small class="muted">{{ '%+d' % r.variance_pct }}%</small>{% endif %}{% else %}—{% endif %}</td>
        {% if loop.first %}<td class="num" rowspan="{{ rows | length }}">{{ c.evidence_quality if c.evidence_quality is not none else '—' }}{% if c.evidence_quality is not none %}/100{% endif %}</td>
        <td rowspan="{{ rows | length }}">{% if c.ic_decision %}{{ 'Approved' if c.ic_decision.kind == 'approval' else 'Declined' }} by {{ c.ic_decision.author }}<br><small class="muted">{{ c.ic_decision.created_at[:10] }}</small>{% else %}—{% endif %}</td>{% endif %}
      </tr>
      {% endfor %}
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<p class="muted">No company is marked invested yet. Move a company to “Invested” in its company record.</p>{% endif %}
</section>

<footer class="footer">
  <p style="margin:0 0 4px">Methodology 2.0: expected impact = reach × depth × duration × (1 − deadweight) × attribution × probability of success, with ranges set by the evidence level of each figure. Totals add company P50s per unit and are indicative.</p>
  <p style="margin:0">Generated by Impact Vision from the company record.</p>
</footer>
</main>
</body>
</html>
